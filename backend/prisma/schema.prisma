// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  ADMIN
  RECRUITER
}

enum CandidateLevel {
  TRAINEE
  JUNIOR
  SEMI_SENIOR
  SENIOR
  LEAD
}

enum VacancyStatus {
  OPEN
  CLOSED
  PAUSED
}

enum SelectionStatus {
  APPLIED
  CONTACTED
  INTERVIEW
  REJECTED
  HIRED
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  apellido     String
  email        String   @unique
  passwordHash String
  rol          UserRole

  empresas     UsuarioEmpresa[]
}

model Empresa {
  id                 String   @id @default(uuid())
  nombre             String
  industria          String?
  sitioWeb           String?
  pais               String?
  ciudad             String?
  objetivoDiversidad Float?

  usuarios           UsuarioEmpresa[]
  vacantes           Vacante[]
  metricasDiversidad MetricaDiversidad[]
  gruposDiversidad EmpresaGrupoDiversidad[]
}

model EmpresaGrupoDiversidad {
  empresaId String
  grupoId String

  empresa Empresa @relation(fields: [empresaId], references: [id])
  grupo GrupoDiversidad @relation(fields: [grupoId], references: [id])

  @@id([empresaId, grupoId])
}

model UsuarioEmpresa {
  usuarioId String
  empresaId String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, empresaId])
}

model Region {
  id        String @id @default(uuid())
  nombre    String
  pais      String
  latitud   Float
  longitud  Float

  candidatos Candidato[]
  vacantes   Vacante[]
  insights   InsightRegion[]
}

model GrupoDiversidad {
  id     String @id @default(uuid())
  nombre String @unique

  candidatos CandidatoGrupoDiversidad[]
  empresas EmpresaGrupoDiversidad[]
}

model Candidato {
  id                String @id @default(uuid())
  nombre            String
  apellido          String
  email             String
  telefono          String?

  nivel             CandidateLevel
  experienciaMeses  Int

  linkedin          String?
  portfolio         String?

  regionId          String
  region            Region @relation(fields: [regionId], references: [id])

  skills            CandidatoSkill[]
  gruposDiversidad  CandidatoGrupoDiversidad[]

  matches           Match[]
  procesosSeleccion ProcesoSeleccion[]
}

model CandidatoGrupoDiversidad {
  candidatoId String
  grupoId     String

  candidato Candidato       @relation(fields: [candidatoId], references: [id])
  grupo     GrupoDiversidad @relation(fields: [grupoId], references: [id])

  @@id([candidatoId, grupoId])
}

model Skill {
  id        String @id @default(uuid())
  nombre    String
  categoria String?

  candidatos CandidatoSkill[]
  vacantes   VacanteSkill[]
}

model CandidatoSkill {
  candidatoId String
  skillId     String

  nivel       Int

  candidato Candidato @relation(fields: [candidatoId], references: [id])
  skill      Skill     @relation(fields: [skillId], references: [id])

  @@id([candidatoId, skillId])
}

model Vacante {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  titulo          String
  descripcion     String

  nivelRequerido  CandidateLevel
  experienciaMeses  Int @default(0)

  regionId        String
  region          Region @relation(fields: [regionId], references: [id])

  diversidadMinima Float?
  antiSesgo        Boolean @default(false)

  estado VacancyStatus

  skills            VacanteSkill[]
  matches           Match[]
  procesosSeleccion ProcesoSeleccion[]

  pesos VacantePeso?
}

model VacantePeso {
  vacanteId String @id

  pesoSkills       Float @default(0.5)
  pesoNivel        Float @default(0.3)
  pesoExperiencia  Float @default(0.2)

  vacante Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
}

model VacanteSkill {
  vacanteId String
  skillId   String

  obligatorio Boolean @default(true)

  vacante Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([vacanteId, skillId])
}

model Match {
  id String @id @default(uuid())

  vacanteId   String
  candidatoId String

  vacante   Vacante   @relation(fields: [vacanteId], references: [id])
  candidato Candidato @relation(fields: [candidatoId], references: [id])

  score            Float
  skillsScore      Float
  experienciaScore Float
  regionScore      Float //nivelScore

  badgeDiversidad Boolean

  fechaMatch DateTime @default(now())
  @@unique([vacanteId, candidatoId])
}

model ProcesoSeleccion {
  id String @id @default(uuid())

  vacanteId   String
  candidatoId String

  vacante   Vacante   @relation(fields: [vacanteId], references: [id])
  candidato Candidato @relation(fields: [candidatoId], references: [id])

  estado SelectionStatus

  fechaActualizacion DateTime @updatedAt
}

model MetricaDiversidad {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  fecha DateTime

  vacantesPublicadas      Int
  candidatosEvaluados     Int
  candidatosDiversidad    Int

  contratacionesTotales   Int
  contratacionesDiversidad Int
}

model InsightRegion {
  id String @id @default(uuid())

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  concentracionTalento Int
  coberturaRed         Float
  perfilesDisponibles  Int

  fechaActualizacion DateTime @updatedAt
}